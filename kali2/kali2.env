# Keycloak Authentication Server Configuration (runs on Kali2)
KEYCLOAK_HOST=http://localhost:8080
REALM=zta
CLIENT_ID=pep-backend
CLIENT_SECRET=

# Protected Resource Service Configuration (runs on Kali4)
RESOURCE_HOST=192.168.200.4
RESOURCE_PORT=5001

# Policy Decision Point (PDP) Configuration (runs on Kali2)
PDP_HOST=192.168.200.2
PDP_PORT=5002
PDP_TIMEOUT=5.0

# PEP Service Configuration (runs on Kali2)
PEP_HOST=192.168.200.2
PEP_PORT=5003

# Zero Trust Network Configuration
ZT_SEGMENT=zt_segment
ALLOWED_NETWORKS=intranet,zt_segment

# PEP Client Configuration
CLIENT_HOST=192.168.200.2
CLIENT_PORT=5000

# FreeRADIUS Configuration (Kali1)
RADIUS_HOST=192.168.200.1
RADIUS_PORT=1812
RADIUS_SECRET=testing123

